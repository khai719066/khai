# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  def require_env!(key)
    value = ENV[key]
    UI.user_error!("Missing required environment variable #{key}") if value.nil? || value.strip.empty?
    value
  end

  def environment_config(environment)
    configs = {
      "dev" => {
        gradle_task: "clean assembleDevRelease",
        app_id_env: "FIREBASE_APP_ID_DEV",
        apk_path: "app/build/outputs/apk/dev/release/myapp-dev-release.apk",
        package_name: "com.cicd.app.dev"
      },
      "staging" => {
        gradle_task: "clean assembleStagingRelease",
        app_id_env: "FIREBASE_APP_ID_STAGING",
        apk_path: "app/build/outputs/apk/staging/release/myapp-staging-release.apk",
        package_name: "com.cicd.app.staging"
      },
      "prod" => {
        gradle_task: "clean assembleProdRelease",
        app_id_env: "FIREBASE_APP_ID_PROD",
        apk_path: "app/build/outputs/apk/prod/release/myapp-prod-release.apk",
        package_name: "com.cicd.app"
      }
    }

    config = configs[environment]
    UI.user_error!("Unknown environment #{environment}") if config.nil?
    config
  end

  def release_build(environment)
    config = environment_config(environment)
    gradle(
      task: config[:gradle_task],
      flags: "--stacktrace --warning-mode all"
    )
  end

  def distribute_build(environment)
    ENV["NODE_BINARY"] ||= sh("which node").strip
    firebase_token = require_env!("FIREBASE_TOKEN")
    config = environment_config(environment)
    firebase_app_id = require_env!(config[:app_id_env])

    release_build(environment)

    firebase_app_distribution(
      app: firebase_app_id,
      firebase_cli_token: firebase_token,
      apk_path: config[:apk_path],
      release_notes: "Ban build #{environment} moi tu Fastlane",
      debug: true
    )
  end

  desc "Runs all the tests"
  lane :test do
    gradle(task: "assembleProdRelease")
  end

  desc "Submit a new Dev build to Firebase App Distribution"
  lane :beta_dev do
    distribute_build("dev")
  end

  desc "Submit a new Staging build to Firebase App Distribution"
  lane :beta_staging do
    distribute_build("staging")
  end

  desc "Submit a new Prod build to Firebase App Distribution"
  lane :beta_prod do
    distribute_build("prod")
  end

  desc "Backward-compatible prod beta lane"
  lane :beta do
    distribute_build("prod")
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do
    ENV["NODE_BINARY"] ||= sh("which node").strip
    release_build("prod")
    upload_to_play_store
  end
end
